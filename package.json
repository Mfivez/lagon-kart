{
  "name": "lagon-kart",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server/index.js",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:network": "node --import tsx scripts/network-check.ts",
    "test:browser": "node --import tsx scripts/browser-check.ts",
    "test:tournament": "node --import tsx scripts/tournament-check.ts",
    "test:browser-tournament": "node --import tsx scripts/browser-tournament-check.ts",
    "test:tournament-configuration": "node --import tsx scripts/tournament-configuration-check.ts",
    "test:kart-visual": "node --import tsx scripts/kart-visual-check.ts",
    "test:kart-demo": "node --import tsx scripts/kart-demo-check.ts",
    "test:music": "node --import tsx scripts/music-check.ts",
    "prepare:music": "python3 scripts/prepare-music.py",
    "check:music": "python3 scripts/prepare-music.py --check",
    "test:items-browser": "node --import tsx scripts/items-browser-check.ts",
    "prepare:kart": "python3 scripts/prepare-kart.py",
    "check:kart": "python3 scripts/prepare-kart.py --check",
    "prepare:kart-library": "python3 scripts/prepare-kart-library.py",
    "check:kart-library": "python3 scripts/prepare-kart-library.py --check",
    "test:kart-library": "node --import tsx scripts/kart-library-check.ts",
    "test:characters": "node --import tsx scripts/characters-check.ts",
    "test:characters-roster": "node --import tsx scripts/characters-roster-check.ts",
    "test:features-browser": "node --import tsx scripts/features-browser-check.ts",
    "test:circuits-browser": "node --import tsx scripts/circuits-browser-check.ts",
    "test:final-race": "node --import tsx scripts/final-race-check.ts",
    "test:docker-persistence": "node --import tsx scripts/docker-persistence-check.ts",
    "test:mobile-browser": "node --import tsx scripts/mobile-browser-check.ts",
    "test:mobile-stick": "node --import tsx scripts/mobile-stick-check.ts",
    "test:scenes-browser": "node --import tsx scripts/scenes-browser-check.ts",
    "test:accounts-browser": "node --import tsx scripts/accounts-browser-check.ts",
    "test:accounts-public": "node --import tsx scripts/accounts-public-check.ts",
    "test:cpu-obstacles-browser": "node --import tsx scripts/cpu-obstacles-browser-check.ts",
    "test:cpu-race": "node --import tsx scripts/cpu-race-check.ts",
    "test:accounts-persistence": "node --import tsx scripts/accounts-persistence-check.ts",
    "test:storage-migration": "node scripts/storage-migration-check.mjs",
    "data:migrate": "node scripts/player-data.mjs migrate",
    "data:backup": "node scripts/player-data.mjs backup",
    "data:reset": "node scripts/player-data.mjs reset",
    "test:track-editor": "node --import tsx scripts/track-editor-browser-check.ts",
    "test:editor-features": "node --import tsx scripts/editor-features-browser-check.ts",
    "test:presence-browser": "node --import tsx scripts/presence-browser-check.ts",
    "test:custom-track-race": "node --import tsx scripts/custom-track-race-check.ts",
    "test:experience": "node --import tsx scripts/experience-audit.ts",
    "test:workshop-browser": "node --import tsx scripts/interactive-workshop-browser-check.ts",
    "test:party-browser": "node --import tsx scripts/party-crown-browser-check.ts",
    "test:ux-ranked": "node --import tsx scripts/ux-ranked-browser-check.ts",
    "test:ux-editor": "node --import tsx scripts/ux-editor-browser-check.ts",
    "test:ux-driving": "node --import tsx scripts/ux-driving-check.ts",
    "test:ux-public": "node --import tsx scripts/ux-public-check.ts"
  },
  "dependencies": {
    "@colyseus/core": "0.16.26",
    "@colyseus/schema": "3.0.76",
    "@colyseus/ws-transport": "0.16.5",
    "colyseus.js": "0.16.22",
    "qrcode-generator": "2.0.4",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "@types/three": "0.183.1",
    "concurrently": "9.2.4",
    "jsqr": "1.4.0",
    "playwright": "1.58.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "6.4.4"
  }
}
